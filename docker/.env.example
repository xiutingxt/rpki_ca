# Copy this file to docker/.env before running Docker Compose.
# These values are used only when /data is initialized for the first time.
REPOSITORY_URI=rsync://localhost/rpki/
CA_NAME=development-ca
DEVELOPMENT_CA_VALIDITY_DAYS=365
CA_RENEW_BEFORE_DAYS=30
ROA_VALID_WEEKS=52
ASPA_VALID_WEEKS=52
PUBLISH_NEXT_HOURS=24
PUBLISH_NEXT_JITTER_HOURS=4
PUBLISH_HOURS_BEFORE_NEXT=8
# Space-separated resources held by the development trust anchor.
CA_RESOURCES=192.0.2.0/24 2001:db8::/48
# Space-separated ASN resources required for ASPA signing.
CA_AS_RESOURCES=64496
# Required by POST/GET API operations. Replace this development value.
API_TOKEN=change-this-to-a-long-random-token
API_PORT=3000
# Optional exact frontend origin, for example http://localhost:5173.
CORS_ORIGIN=
